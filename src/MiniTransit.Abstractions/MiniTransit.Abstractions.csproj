<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<LangVersion>13.0</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Authors>Matt Bentley</Authors>
		<Version>1.0.0</Version>
		<Product>MiniTransit</Product>
		<Description>MiniTransit is a lightweight, extensible .NET messaging library. Abstractions for MiniTransit.</Description>
		<PackageProjectUrl>https://github.com/matt-bentley/MiniTransit</PackageProjectUrl>
		<RepositoryUrl>https://github.com/matt-bentley/MiniTransit</RepositoryUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
	</PropertyGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>MiniTransit</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>DynamicProxyGenAssembly2</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

</Project>
